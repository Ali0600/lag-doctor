<?xml version="1.0" encoding="utf-8"?>
<!--
  lag-doctor's per-machine MSI (docs/INSTALLER-PLAN.md, Stage 3), built with WiX v7 by scripts/msi_build.py:

    wix build lag-doctor.wxs -arch x64 -wx -d Version=X.Y.Z -bindpath payload=C:\...\payload -o lag-doctor.msi

  The payload is the install folder as msi_build.py laid it out and checked it: python.org's embeddable runtime,
  lagdoctor\ with its bytecode, PresentMon\ with Intel's licence, and bin\lagdoctor.cmd. It installs to
  C:\Program Files\lag-doctor; bin\ goes on the system PATH and comes off it on uninstall, and the app gets a
  shortcut in every account's Start menu. No dialogs and no custom actions: one UAC prompt, then done. Syntax checked
  against WiX v7.0.1's documentation and source (2026-11-08).

  The UpgradeCode names lag-doctor across every version, so it never changes (tests/test_msi.py pins it).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="lag-doctor" Manufacturer="lag-doctor" Version="$(Version)"
           UpgradeCode="{955424CD-63D8-410A-A74B-618FC618CDBA}" Scope="perMachine" Language="1033"
           Codepage="1252">
    <!-- Every build of one version may replace another (CI makes many); an older one never replaces a newer. The
         default schedule removes the old product entirely before the new one installs. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of lag-doctor is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Ali0600/lag-doctor" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="lag-doctor">
        <Directory Id="BINFOLDER" Name="bin" />
      </Directory>
    </StandardDirectory>

    <!-- The payload, its folders kept. bin\ is harvested into BINFOLDER itself, the folder PATH names. -->
    <Files Directory="INSTALLFOLDER" Include="!(bindpath.payload)\**">
      <Exclude Files="!(bindpath.payload)\bin\**" />
    </Files>
    <Files Directory="BINFOLDER" Include="!(bindpath.payload)\bin\**" />

    <!-- bin\ alone goes on the system PATH, at its end, so the runtime's python.exe never stands in for the user's
         own python. Part="last" adds only this part and the uninstall removes only it (a missing Part would replace
         the whole PATH). A folder key path needs a fixed Id and Guid; WiX adds the CreateFolder row itself. -->
    <Component Id="PathEntry" Directory="BINFOLDER" Guid="{EEC3F812-94EF-4DD5-8F80-2A76D6176B6A}">
      <Environment Id="PathEntry" Name="PATH" Value="[BINFOLDER]" Part="last" Action="set" System="yes"
                   Permanent="no" />
    </Component>

    <!-- The app's Start-menu shortcut (docs/LAUNCHER-PLAN.md, The window: Identity), straight in the Start menu's
         Programs folder, which a per-machine install makes the one every account sees. It starts the installed
         runtime's pythonw.exe, which opens no console, on `-m lagdoctor app`, with lag-doctor's icon and the app's
         AppUserModel ID: the process sets the same ID before its window opens (APP_ID in lagdoctor/app/__init__.py;
         tests/test_msi.py holds the two equal), so the taskbar shows, pins and relaunches lag-doctor, not Python.
         Target names the folder rather than [#file], which would need the harvested file's generated id.
         The component's key path is a value under HKCU: for a shortcut that is not advertised, in a Start-menu
         folder, it is the one key path Windows Installer's ICEs accept even in a per-machine package (WiX v7.0.1's
         darice.cub run over each choice, 2026-11-08: HKMU fails ICE57; HKLM fails ICE38, ICE43 and ICE57; a file
         fails ICE43 and ICE57; the folder fails ICE18, ICE38 and ICE43). The value goes in the installing account's
         hive and goes with the uninstall. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="{01802E5D-285B-4DE1-9453-DA5F7F1BDAC5}">
        <Shortcut Id="AppShortcut" Name="lag-doctor" Target="[INSTALLFOLDER]pythonw.exe" Arguments="-m lagdoctor app"
                  WorkingDirectory="INSTALLFOLDER">
          <Icon Id="lagdoctor.ico" SourceFile="!(bindpath.payload)\lagdoctor\app\lag-doctor.ico" />
          <ShortcutProperty Key="System.AppUserModel.ID" Value="LagDoctor.App" />
        </Shortcut>
        <RegistryValue Root="HKCU" Key="Software\lag-doctor" Name="StartMenuShortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Package>
</Wix>
